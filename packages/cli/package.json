{
  "name": "@sopkit/cli",
  "version": "1.2.0",
  "description": "Interactive mouse-and-keyboard terminal application and CLI for SopKit utilities.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "type": "module",
  "bin": {
    "sopkit": "./bin/sopkit.cjs"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "sopkit",
    "cli",
    "interactive",
    "base64",
    "uuid",
    "slug",
    "json",
    "color",
    "jwt",
    "hash",
    "password"
  ],
  "author": "SopKit",
  "license": "MIT",
  "homepage": "https://sopkit.space/"
}
